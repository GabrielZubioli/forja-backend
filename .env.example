# ── Supabase ────────────────────────────────────────────────────────────────
# Ref do projeto (o mesmo valor de `project_id` em supabase/config.toml).
SUPABASE_PROJECT_ID=

# Token pessoal do CLI, usado por `npm run db:types` e `supabase db push`.
# Gere em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Senha do banco, exigida por `supabase db push` contra o projeto remoto.
SUPABASE_DB_PASSWORD=

# ── Edge Function `coach` ───────────────────────────────────────────────────
# Configurada como secret na plataforma, NÃO no .env de deploy:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Sem ela a função responde 503 e o app esconde o chat — o resto segue normal.
ANTHROPIC_API_KEY=

# ── Publicação do @gabrielzubioli/db ─────────────────────────────────────────────────
# Token com escopo `write:packages` para publicar no GitHub Packages.
# Em CI use o GITHUB_TOKEN do próprio workflow.
NODE_AUTH_TOKEN=
