{
  "name": "@forja/backend",
  "private": true,
  "type": "module",
  "description": "Camada de dados e plataforma do Forja: schema Postgres, RLS, Edge Functions e o contrato @forja/db.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:types": "node scripts/gen-types.mjs",
    "db:types:local": "node scripts/gen-types.mjs --local",
    "db:types:check": "npm run db:types && git diff --exit-code -- packages/db/src/types.ts",
    "sync:validate": "node scripts/validate-streams.mjs",
    "db:lint": "supabase db lint --linked --schema public --fail-on warning",
    "db:lint:local": "supabase db lint --local --schema public --fail-on warning",
    "db:diff": "supabase db diff --linked --schema public",
    "db:push": "supabase db push",
    "db:build": "npm run build --workspace @forja/db",
    "db:publish": "npm publish --workspace @forja/db",
    "catalog:exercises": "node scripts/catalog/build-exercises.mjs",
    "catalog:foods": "node scripts/catalog/build-foods.mjs",
    "catalog:gymvisual": "node scripts/catalog/build-gymvisual.mjs",
    "catalog:media": "node scripts/catalog/match-gymvisual-media.mjs",
    "typecheck": "npm run typecheck --workspace @forja/db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run sync:validate && npm run db:build && npm run format:check"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "yaml": "^2.7.0",
    "supabase": "^2.113.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
